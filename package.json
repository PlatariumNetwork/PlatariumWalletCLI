{
  "name": "platarium-wallet-cli",
  "version": "1.0.1",
  "description": "Command-line wallet for the Platarium blockchain",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "platarium-wallet": "./src/index.js"
  },
  "scripts": {
    "install-deps": "node scripts/install-deps.js",
    "setup": "node scripts/setup-rust-core.js",
    "test": "node scripts/verify-setup.js",
    "test:crypto": "node scripts/test-crypto.mjs",
    "start": "node scripts/bootstrap.js"
  },
  "keywords": [
