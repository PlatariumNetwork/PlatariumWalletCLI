    "@noble/secp256k1": "^2.2.3",
    "@scure/bip32": "^1.6.2",
    "@scure/bip39": "^1.5.4",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^9.2.0",
    "ora": "^5.4.1",
    "ws": "^8.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Platarium Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlatariumNetwork/walletPlatariumCLI.git"
  },
  "bugs": {
